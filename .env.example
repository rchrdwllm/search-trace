# SearchTrace foundation does not require service configuration to render.
# Add only public Supabase values when a later integration feature needs them.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test_key

# Direct PostgreSQL connection string for Drizzle ORM
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server-only Better Auth signing secret (minimum 32 characters)
BETTER_AUTH_SECRET=example_secret_must_be_at_least_32_characters_long

# Canonical application origin URL
BETTER_AUTH_URL=http://localhost:3000

# Storage provider override for testing or offline dev ('memory' or default Supabase)
STORAGE_PROVIDER=memory

# --- AI Provider Configuration (Google Gemini via Vercel AI SDK) ---
# Server-only Google Generative AI API Key for Gemini 3.6 Flash
GOOGLE_GENERATIVE_AI_API_KEY=
# Fallback alias supported by Gemini integration
GEMINI_API_KEY=
# Target Gemini model identifier (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
# AI provider override ('memory' for zero-credential offline tests or 'google' for production)
AI_PROVIDER=memory
