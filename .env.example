# SearchTrace foundation does not require service configuration to render.
# Add only public Supabase values when a later integration feature needs them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only direct PostgreSQL URL for Drizzle migrations (never expose to the browser).
DATABASE_URL=
# The opportunity repository temporarily assumes the non-bypass `searchtrace_app`
# role created by the migration; it is granted to the DATABASE_URL migration user.
# Server-only Better Auth signing secret (minimum 32 characters).
BETTER_AUTH_SECRET=
# Canonical application origin, for example http://localhost:3000.
BETTER_AUTH_URL=http://localhost:3000
